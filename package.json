{
  "name": "ac40-regatta-replay",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "test": "vitest run --test-timeout=90000",
    "test:watch": "vitest",
    "test:run": "vitest run --test-timeout=90000",
    "test:browser": "node tests/browser/dashboard.mjs",
    "ingest": "powershell -NoProfile -ExecutionPolicy Bypass -File ./run.ps1 ingest",
    "verify": "powershell -NoProfile -ExecutionPolicy Bypass -File ./run.ps1 verify"
  },
  "dependencies": {
    "maplibre-gl": "^6.14.0",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.4",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "playwright": "^1.62.1",
    "typescript": "7.0.2",
    "vite": "8.3.3",
    "vitest": "5.0.3"
  }
}
